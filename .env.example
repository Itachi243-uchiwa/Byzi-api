# Copier en .env AVANT tout `docker compose up` :
#
#   cp .env.example .env
#
# Ce n'est plus optionnel. Depuis le passage au VPS (2026-09-09), docker-compose.yml
# est le runtime de PRODUCTION : trois variables n'ont donc plus de valeur par defaut
# (SPRING_PROFILES_ACTIVE, POSTGRES_PASSWORD, JWT_SECRET) et `docker compose up`
# echoue avec un message clair si elles manquent. Un demarrage qui echoue bruyamment
# vaut mieux qu'un demarrage qui reussit en mode demonstration sur des donnees reelles.
#
# .env est ignore par git ET par Docker (.dockerignore) : il ne doit jamais etre
# commite ni finir dans une image.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=byzi
POSTGRES_USER=byzi
# OBLIGATOIRE. Sur le serveur : openssl rand -base64 32
POSTGRES_PASSWORD=byzi
# Le port n'est publie que sur 127.0.0.1 : joignable par un client SQL local,
# jamais depuis l'exterieur du VPS.
POSTGRES_PORT=5432

# --- API ---------------------------------------------------------------------
API_PORT=8080

# OBLIGATOIRE, et c'est la variable la plus dangereuse a oublier sur le serveur :
#   prod = production
#   demo = jeu de donnees FICTIF + compte admin admin@byzi.app / byzi-demo, dont le
#          mot de passe est ecrit en clair dans les journaux de demarrage
#   dev  = base vide
SPRING_PROFILES_ACTIVE=demo

# --- Secrets -----------------------------------------------------------------
# OBLIGATOIRE. Au moins 32 octets (256 bits), verifie au demarrage par JwtService :
#   openssl rand -base64 48
JWT_SECRET=docker-dev-secret-key-at-least-32-bytes-long

# Liste blanche d'origines, separees par des virgules. Jamais de "*" en production.
# L'app iOS n'est PAS concernee : un client natif n'envoie pas d'Origin, le CORS ne
# le bloque donc jamais.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- App Store Server Notifications V2 ---------------------------------------
# URL a renseigner dans App Store Connect > App Information > App Store Server
# Notifications, version 2 : https://<host>/api/v1/webhooks/apple
#
# APPLE_ENVIRONMENT filtre reellement : le verificateur d'Apple rejette une
# notification dont l'environnement ne correspond pas. Laisser SANDBOX en production
# fait refuser silencieusement TOUS les evenements de facturation reels -
# renouvellements et remboursements compris.
APPLE_BUNDLE_ID=Dopamyn-APP.dopamyn-app
APPLE_ENVIRONMENT=SANDBOX
# Identifiant numerique de l'app dans App Store Connect.
# OBLIGATOIRE des que APPLE_ENVIRONMENT vaut PRODUCTION.
APPLE_APP_ID=

# --- Premier administrateur du back-office -----------------------------------
# Vides par defaut : sans eux, AUCUN compte admin n'existe et /admin est
# inaccessible. C'est voulu - il n'y a deliberement aucun identifiant par defaut.
#
# Demarrage a froid : renseigner les deux, demarrer UNE fois, se connecter sur
# /admin, changer le mot de passe depuis "Mon compte", puis VIDER ces deux lignes.
# Le mot de passe fait 12 caracteres minimum, sinon le serveur refuse et journalise.
BYZI_ADMIN_BOOTSTRAP_EMAIL=
BYZI_ADMIN_BOOTSTRAP_PASSWORD=

# --- Parrainage --------------------------------------------------------------
# Jours offerts au filleul ET au parrain a chaque utilisation d'un code (backlog 10.8).
# Levier commercial : doubler l'offre le temps d'une campagne ne demande ni deploiement
# ni mise a jour de l'app. Plafonne a 90 jours cote serveur.
REFERRAL_TRIAL_EXTENSION_DAYS=7
