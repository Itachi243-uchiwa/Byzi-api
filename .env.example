# Copier en .env pour surcharger les valeurs par defaut de docker-compose.yml :
#
#   cp .env.example .env
#
# .env est ignore par git ET par Docker (.dockerignore) : il ne doit jamais etre
# commite ni finir dans une image. Sans ce fichier, docker-compose fonctionne quand
# meme avec les valeurs de developpement par defaut.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=byzi
POSTGRES_USER=byzi
POSTGRES_PASSWORD=byzi
POSTGRES_PORT=5432

# --- API ---------------------------------------------------------------------
API_PORT=8080

# demo = jeu de donnees fictif pour le back-office
# dev  = base vide
SPRING_PROFILES_ACTIVE=demo

# --- Secrets -----------------------------------------------------------------
# Au moins 32 octets (256 bits) : c'est verifie au demarrage par JwtService.
# En production, generer une valeur aleatoire, par exemple :
#   openssl rand -base64 48
JWT_SECRET=docker-dev-secret-key-at-least-32-bytes-long

# A recopier depuis le dashboard RevenueCat (champ "Authorization header").
REVENUECAT_WEBHOOK_SECRET=docker-dev-revenuecat-secret

# Liste blanche d'origines, separees par des virgules. Jamais de "*" en production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Parrainage --------------------------------------------------------------
# Jours offerts au filleul ET au parrain a chaque utilisation d'un code (backlog 10.8).
# Levier commercial : doubler l'offre le temps d'une campagne ne demande ni deploiement
# ni mise a jour de l'app. Plafonne a 90 jours cote serveur.
REFERRAL_TRIAL_EXTENSION_DAYS=7
